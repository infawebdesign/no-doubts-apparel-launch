{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "no-doubts-apparel-launchs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [{ "pattern": "nodoubts.ca", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "SQUARE_LOCATION_ID": "LRFYM2F3WGKG7",
    "SQUARE_MERCHANT_ID": "MLJY1JYR27C1Z",
    "SQUARE_ENVIRONMENT": "production",
    "PUBLIC_SITE_URL": "https://nodoubts.ca",
    "SHIPPING_EMAIL_FROM": "orders@nodoubts.ca",
    "SHIPPING_EMAILS_ENABLED": "true",
    "SHIPPING_EMAILS_START_AT": "2026-09-30T18:45:23Z",
    "MERCHANT_ORDER_EMAIL_TO": "nodoubts.ca@gmail.com",
    "MERCHANT_ORDER_EMAILS_START_AT": "2026-10-01T00:08:35Z",
  },
  "d1_databases": [
    {
      "binding": "SQUARE_DB",
      "database_name": "no-doubts-square",
      "database_id": "2d0499df-d243-4719-8a3b-3b28890071d7",
    },
  ],
}
